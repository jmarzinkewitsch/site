<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.tv-top-shelf</string>
		<key>NSExtensionPrincipalClass</key>
		<string>$(PRODUCT_MODULE_NAME).TopShelfContentProvider</string>
	</dict>
	<!-- The extension has its own Info.plist and does not inherit the host
	     app's ATS settings. Self-hosted Jellyfin runs as plain HTTP on the
	     LAN (192.168.x.x), so allow it here too — otherwise TopShelfClient
	     requests and HTTP artwork URLs are blocked and Top Shelf stays empty. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
</dict>
</plist>
