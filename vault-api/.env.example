# Copy to .env (gitignored). Compose passes these to the container.

# Redis connection for the cache (empty/unset = no cache, degrades gracefully).
REDIS_URL=redis://redis:6379/0

# Where the JSON config (written by the admin UI) is persisted.
VAULT_CONFIG_PATH=/data/config.json

# Optional bootstrap: seed empty fields on first start so you can skip the UI.
# The admin UI overrides these once used.
# VAULT_BEARER_TOKEN=
# JELLYFIN_URL=http://192.168.1.10:8096
# JELLYFIN_TOKEN=
# JELLYFIN_USER_ID=
